---
import { Icon } from 'astro-icon/components';
type Variant = 'icon-only' | 'icon-only-boxed' | 'icon-with-label';
interface Props { variant?: Variant; iconClass?: string; containerClass?: string; }
const { variant = 'icon-only', iconClass, containerClass } = Astro.props;
const links = [
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/vedanshivala/', icon: 'simple-icons:linkedin', external: true },
  { name: 'Email Vedanshi', href: 'mailto:vedanshi.vala@icahn.mssm.edu', icon: 'heroicons:envelope', external: false },
  { name: 'BOLT Safety Society', href: 'https://boltsafety.org', icon: 'heroicons:globe-alt', external: true },
];
const finalContainerClass = containerClass ?? (variant === 'icon-with-label' ? 'space-y-2' : 'flex items-center gap-4');
const finalIconClass = iconClass ?? (variant === 'icon-with-label' ? 'w-4 h-4 shrink-0' : 'w-5 h-5');
---
{variant === 'icon-with-label' ? (
  <ul class={finalContainerClass}>
    {links.map((link) => <li><a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined} class="text-sm text-muted hover:text-neon-rose inline-flex items-center gap-2"><Icon name={link.icon} class={finalIconClass} aria-hidden="true" />{link.name}</a></li>)}
  </ul>
) : (
  <div class={finalContainerClass}>
    {links.map((link) => <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined} aria-label={link.name} class={variant === 'icon-only-boxed' ? 'w-10 h-10 rounded-lg bg-surface border border-black/5 shadow-neon-sm flex items-center justify-center text-muted hover:text-neon-rose hover:border-neon-rose/20' : 'text-muted hover:text-neon-rose p-1'}><Icon name={link.icon} class={finalIconClass} aria-hidden="true" /></a>)}
  </div>
)}
