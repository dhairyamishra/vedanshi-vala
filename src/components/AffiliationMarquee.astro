---
import { Icon } from 'astro-icon/components';

interface Affiliation {
  name: string;
  detail: string;
  image?: string;
  imageAlt?: string;
  imageClass?: string;
  imageWrapClass?: string;
  icon?: string;
  iconClass?: string;
}

const experienceAffiliations: Affiliation[] = [
  {
    "name": "BOLT Safety Society",
    "detail": "Nonprofit leadership",
    "image": "images/organizations/bolt.jpg",
    "imageAlt": "BOLT Safety Society",
    "imageClass": "h-8 w-20 object-contain"
  },
  {
    "name": "Concordia",
    "detail": "Events & CRM systems"
  },
  {
    "name": "BC Heritage Fairs",
    "detail": "Board & provincial fair",
    "image": "images/organizations/heritage.png",
    "imageAlt": "BC Heritage Fairs",
    "imageClass": "h-8 w-20 object-contain"
  },
  {
    "name": "St. John Ambulance",
    "detail": "First aid & youth leadership",
    "image": "images/organizations/st-john.svg",
    "imageAlt": "St. John Ambulance",
    "imageClass": "h-8 w-20 object-contain"
  },
  {
    "name": "Icahn School of Medicine",
    "detail": "MPH · Global Health",
    "image": "images/organizations/icahn.png",
    "imageAlt": "Icahn School of Medicine",
    "imageClass": "h-8 w-20 object-contain"
  }
];

const researchAffiliations: Affiliation[] = [
  {
    "name": "Berner Lab",
    "detail": "Clinical research training",
    "image": "images/organizations/icahn.png",
    "imageAlt": "Berner Lab",
    "imageClass": "h-8 w-20 object-contain"
  },
  {
    "name": "BC Injury Research",
    "detail": "SHRed Concussions Study",
    "image": "images/organizations/injury.png",
    "imageAlt": "BC Injury Research",
    "imageClass": "h-8 w-20 object-contain"
  },
  {
    "name": "Antarctic Institute",
    "detail": "Research & publications",
    "image": "images/organizations/antarctic.jpg",
    "imageAlt": "Antarctic Institute",
    "imageClass": "h-8 w-20 object-contain"
  },
  {
    "name": "UBC · QMI",
    "detail": "Nanomaterials research"
  },
  {
    "name": "UBC",
    "detail": "Integrated Sciences"
  }
];

const rows = [
  { items: experienceAffiliations, direction: 'right' },
  { items: researchAffiliations, direction: 'left' },
];
---

<aside class="affiliation-panel" aria-labelledby="affiliation-heading">
  <div class="flex items-end justify-between gap-5 px-5 pt-5">
    <div>
      <p class="text-[10px] font-heading font-semibold uppercase tracking-[0.18em] text-neon-rose">
        Experience, education & research
      </p>
      <h2 id="affiliation-heading" class="mt-2 text-base font-heading font-semibold text-text-bright">
        Built across community leadership, public health, and research.
      </h2>
    </div>
  </div>

  <div class="mt-4 space-y-2.5 pb-5">
    {rows.map((row) => (
      <div class="affiliation-viewport">
        <div class={`affiliation-track affiliation-track-${row.direction}`}>
          {[false, true].map((duplicate) => (
            <div class="affiliation-set" aria-hidden={duplicate ? 'true' : undefined}>
              {row.items.map((item) => (
                <div class="affiliation-pill">
                  {item.image && (
                    <span class={`flex flex-none items-center justify-center ${item.imageWrapClass ?? ''}`}>
                      <img
                        src={`${import.meta.env.BASE_URL}${item.image}`}
                        alt={duplicate ? '' : item.imageAlt ?? ''}
                        class={item.imageClass}
                        loading="eager"
                        decoding="async"
                      />
                    </span>
                  )}
                  {item.icon && <Icon name={item.icon} class={item.iconClass} aria-hidden="true" />}
                  <span class="whitespace-nowrap">
                    <span class="block text-xs font-heading font-semibold leading-none text-text-bright">{item.name}</span>
                    <span class="mt-1 block text-[10px] leading-none text-muted">{item.detail}</span>
                  </span>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</aside>

<style>
  .affiliation-panel {
    overflow: hidden;
    border: 1px solid rgb(36 26 20 / 0.1);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.72);
    box-shadow: 0 18px 40px rgb(36 26 20 / 0.07);
    backdrop-filter: blur(12px);
  }

  .affiliation-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }

  .affiliation-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation-duration: 34s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .affiliation-track-left {
    animation-name: affiliation-scroll-left;
  }

  .affiliation-track-right {
    animation-name: affiliation-scroll-right;
  }

  .affiliation-set {
    display: flex;
    flex: none;
    gap: 0.625rem;
    padding-right: 0.625rem;
  }

  .affiliation-pill {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid rgb(36 26 20 / 0.08);
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 0.9);
    padding: 0.55rem 0.8rem;
    box-shadow: 0 8px 18px rgb(36 26 20 / 0.05);
  }

  .affiliation-panel:hover .affiliation-track,
  .affiliation-panel:focus-within .affiliation-track {
    animation-play-state: paused;
  }

  @keyframes affiliation-scroll-left {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @keyframes affiliation-scroll-right {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .affiliation-track {
      animation: none;
      transform: none;
    }

    .affiliation-set[aria-hidden='true'] {
      display: none;
    }
  }
</style>
