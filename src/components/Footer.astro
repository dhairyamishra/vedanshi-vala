---
import SocialLinks from './SocialLinks.astro';
const currentYear = new Date().getFullYear();
const quickLinks = [
  { name: 'About', href: '#about' },
  { name: 'Experience', href: '#experience' },
  { name: 'Contact', href: '#contact' },
];
---
<footer class="relative">
  <div class="divider-neon"></div>
  <div class="section-container py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <a href="#about" aria-label="Vedanshi Vala, back to top" class="text-2xl font-heading font-bold text-gradient-rose">VV<span class="text-neon-rose">.</span></a>
        <p class="mt-3 text-sm text-muted max-w-xs">Public health leadership grounded in community safety, research, and equity.</p>
      </div>
      <div>
        <h2 class="text-sm font-heading font-semibold text-text uppercase tracking-wider mb-4">Explore</h2>
        <ul class="space-y-2">{quickLinks.map((link) => <li><a href={link.href} class="text-sm text-muted hover:text-neon-rose">{link.name}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="text-sm font-heading font-semibold text-text uppercase tracking-wider mb-4">Connect</h2>
        <SocialLinks variant="icon-with-label" />
      </div>
    </div>
    <div class="divider-neon mt-8 mb-6"></div>
    <div class="flex flex-col sm:flex-row justify-between items-start gap-3 text-xs text-muted">
      <p>&copy; {currentYear} Vedanshi Vala.</p>
      <p>Public health. Community safety. Equity.</p>
    </div>
  </div>
</footer>
