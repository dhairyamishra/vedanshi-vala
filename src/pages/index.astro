---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import HomeProjectCard from '../components/HomeProjectCard.astro';
import AffiliationMarquee from '../components/AffiliationMarquee.astro';
import VerifiedBrandBadge from '../components/VerifiedBrandBadge.astro';
import profileImg from '../assets/profile.jpg';

import { outcomes, caseStudies, featuredProjects, experienceSignals, technicalAreas } from '../data/home';
---

<Layout
  title="Vedanshi Vala — Public Health Leader & Founder"
  description="Vedanshi Vala is a public health leader, co-founder of BOLT Safety Society, and MPH candidate advancing safety and equity."
  ogType="profile"
>
  <Navigation />

  <main id="main-content">
    <section class="relative overflow-hidden border-b border-black/5 py-12 md:py-14 lg:py-16">
      <div class="absolute inset-0 grid-bg opacity-35"></div>
      <div class="absolute -left-24 top-10 h-80 w-80 rounded-full bg-neon-gold/10 blur-3xl"></div>
      <div class="absolute -right-24 bottom-0 h-80 w-80 rounded-full bg-neon-rose/10 blur-3xl"></div>

      <div class="section-container relative z-10">
        <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1.25fr)_minmax(340px,0.75fr)] lg:gap-14">
          <div class="reveal">
            <div class="md:flex md:items-start md:gap-6 lg:block">
              <div class="min-w-0">
                <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-neon-rose sm:text-sm">
                  Vedanshi Vala · Public Health Leader · MPH Candidate
                </p>
                <h1 class="mt-5 max-w-4xl text-5xl font-heading font-bold leading-[0.98] tracking-[-0.04em] text-text-bright sm:text-6xl lg:text-7xl">
                  I build safer, more equitable communities.
                </h1>
              </div>
              <Image
                src={profileImg}
                alt="Vedanshi Vala"
                width={448}
                height={448}
                loading="eager"
                class="mt-6 h-40 w-40 flex-none rounded-3xl border-2 border-neon-rose/25 object-cover shadow-[0_20px_40px_rgba(36,26,20,0.14)] md:mt-0 md:h-48 md:w-48 lg:hidden"
              />
            </div>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-light md:text-xl">
              Co-Founder and Executive Director of BOLT Safety Society. I scale public health initiatives through community leadership, research, partnerships, and advocacy that advance safety and equity.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href={`${import.meta.env.BASE_URL}projects/`} class="btn-neon-fill">See selected work</a>
              <a href={`${import.meta.env.BASE_URL}experience/`} class="btn-neon">View experience</a>
              <a href={`${import.meta.env.BASE_URL}contact/`} class="self-center text-sm font-medium text-muted underline decoration-neon-rose/25 underline-offset-4 hover:text-neon-rose hover:decoration-neon-rose">Get in touch</a>
            </div>

            <div class="mt-9 flex flex-wrap gap-x-6 gap-y-3 border-t border-black/10 pt-5 text-sm text-muted">
              <span><strong class="font-semibold text-text">9+ years</strong> leading public health and safety initiatives</span>
              <span><strong class="font-semibold text-text">Community + research</strong> leadership across countries</span>
              <span><strong class="font-semibold text-text">End-to-end</strong> nonprofit strategy and delivery</span>
            </div>

            <div class="mt-8 hidden lg:block">
              <AffiliationMarquee />
            </div>
          </div>

          <div class="reveal reveal-delay-2 flex flex-col items-start gap-4">
            <Image
              src={profileImg}
              alt="Vedanshi Vala"
              width={448}
              height={448}
              loading="eager"
              class="hidden h-auto w-full rounded-[2rem] border-2 border-neon-rose/25 object-cover shadow-[0_24px_48px_rgba(36,26,20,0.16)] lg:block"
            />

            <aside class="w-full rounded-2xl border border-black/10 bg-surface p-5 shadow-[0_24px_56px_rgba(36,26,20,0.10)]">
              <div class="border-b border-black/10 pb-4">
                <p class="text-[10px] font-heading font-semibold uppercase tracking-[0.18em] text-neon-rose">Proof at a glance</p>
                <p class="mt-2 text-base font-heading font-semibold text-text-bright">Community leadership with measurable outcomes.</p>
              </div>

              <dl class="divide-y divide-black/10">
                {outcomes.map((outcome) => (
                  <div class="grid grid-cols-[72px_minmax(0,1fr)] gap-3 py-3.5">
                    <dt class="font-heading text-2xl font-bold tracking-[-0.04em] text-neon-rose">{outcome.value}</dt>
                    <dd>
                      <p class="text-sm font-semibold leading-snug text-text">{outcome.label}</p>
                      <p class="mt-1 text-xs leading-relaxed text-muted">{outcome.context}</p>
                    </dd>
                  </div>
                ))}
              </dl>

              <a href="#selected-work" class="mt-2 inline-flex items-center text-sm font-medium text-neon-rose hover:text-neon-violet">
                Explore the work behind the numbers
                <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </a>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <section id="selected-work" class="border-b border-black/5 bg-surface-light/40 py-14 md:py-16">
      <div class="section-container">
        <div class="reveal flex flex-col gap-5 border-b border-black/10 pb-7 md:flex-row md:items-end md:justify-between">
          <div class="max-w-3xl">
            <p class="text-xs font-heading font-semibold uppercase tracking-[0.18em] text-neon-rose">Selected initiatives</p>
            <h2 class="mt-3 text-3xl font-heading font-bold tracking-[-0.03em] text-text-bright md:text-4xl">
              See the work before reading the résumé.
            </h2>
          </div>
          <div class="max-w-xl md:text-right">
            <p class="text-sm leading-relaxed text-muted">
              Three areas of work spanning community safety, research, and public engagement. Explore the role, scope, and outcomes behind each initiative.
            </p>
            <a href={`${import.meta.env.BASE_URL}projects/`} class="mt-3 inline-flex items-center text-sm font-medium text-neon-rose hover:text-neon-violet">
              Browse all projects
              <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </a>
          </div>
        </div>

        <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {featuredProjects.map((project, index) => (
            <div class={`reveal reveal-delay-${index + 1} ${index === 2 ? 'md:col-span-2 lg:col-span-1' : ''}`}>
              <HomeProjectCard {...project} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-12 md:py-14">
      <div class="section-container">
        <div class="reveal max-w-3xl">
          <p class="text-xs font-heading font-semibold uppercase tracking-[0.18em] text-neon-rose">How I work</p>
          <h2 class="mt-3 text-3xl font-heading font-bold tracking-[-0.03em] text-text-bright md:text-4xl">
            The work lives at the intersection of leadership, research, and advocacy.
          </h2>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
            I bring people, evidence, and partnerships together to build initiatives that respond to community needs and create lasting public health impact.
          </p>
        </div>

        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {technicalAreas.map((area, index) => (
            <div class={`reveal reveal-delay-${index + 1} border-t-2 border-neon-rose/35 bg-surface px-5 pb-5 pt-5 shadow-neon-sm`}>
              <h3 class="text-lg font-heading font-semibold text-text-bright">{area.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{area.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="enterprise-impact" class="border-y border-black/5 bg-surface-light/40 py-14 md:py-16">
      <div class="section-container">
        <div class="reveal flex flex-col gap-4 border-b border-black/10 pb-8 md:flex-row md:items-end md:justify-between">
          <div class="max-w-3xl">
            <p class="text-xs font-heading font-semibold uppercase tracking-[0.18em] text-neon-rose">Community impact</p>
            <h2 class="mt-3 text-3xl font-heading font-bold tracking-[-0.03em] text-text-bright md:text-4xl">Evidence, not adjectives.</h2>
          </div>
          <p class="max-w-xl text-sm leading-relaxed text-muted">These examples show how leadership, partnership development, and fundraising expanded the reach of community safety initiatives.</p>
        </div>

        <div class="divide-y divide-black/10">
          {caseStudies.map((study, index) => (
            <article class={`reveal reveal-delay-${(index % 3) + 1} grid gap-6 py-10 lg:grid-cols-[84px_minmax(0,1fr)_minmax(250px,0.55fr)] lg:gap-10`}>
              <div class="w-fit min-w-[84px] self-start rounded-xl border border-black/10 bg-surface p-4 shadow-neon-sm">
                <p class="font-mono text-sm text-neon-rose">{study.number}</p>
                <p class="mt-2 text-[10px] font-heading font-semibold uppercase tracking-[0.16em] text-muted">{study.label}</p>
              </div>
              <div>
                <h3 class="max-w-2xl text-2xl font-heading font-semibold leading-tight text-text-bright">{study.title}</h3>
                <div class="mt-5 grid gap-4 sm:grid-cols-2">
                  <div>
                    <p class="text-[10px] font-heading font-semibold uppercase tracking-[0.16em] text-neon-rose">Problem</p>
                    <p class="mt-2 text-sm leading-relaxed text-muted">{study.problem}</p>
                  </div>
                  <div>
                    <p class="text-[10px] font-heading font-semibold uppercase tracking-[0.16em] text-neon-rose">What I owned</p>
                    <p class="mt-2 text-sm leading-relaxed text-muted">{study.ownership}</p>
                  </div>
                </div>
              </div>
              <div class="flex flex-col justify-between rounded-xl border border-black/10 bg-surface p-5">
                <div>
                  <p class="text-[10px] font-heading font-semibold uppercase tracking-[0.16em] text-neon-rose">Result</p>
                  <p class="mt-2 text-xl font-heading font-semibold leading-tight text-text-bright">{study.result}</p>
                  <div class="mt-5 flex flex-wrap gap-1.5">
                    {study.tags.map((tag) => <span class="rounded-full border border-black/5 bg-base px-2 py-1 text-[10px] text-muted">{tag}</span>)}
                  </div>
                </div>
                <a href={study.href} class="mt-7 inline-flex items-center text-sm font-medium text-neon-rose hover:text-neon-violet">
                  {study.link}
                  <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="section-container grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(320px,0.75fr)] lg:items-start">
        <div class="reveal">
          <p class="text-xs font-heading font-semibold uppercase tracking-[0.18em] text-neon-rose">Career signal</p>
          <h2 class="mt-3 max-w-2xl text-3xl font-heading font-bold tracking-[-0.03em] text-text-bright md:text-4xl">
            Built in environments where safety, evidence, and community outcomes all matter.
          </h2>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
            My experience spans nonprofit leadership, international events, community education, emergency response, and research. The common thread is bringing people together around work that improves lives.
          </p>
          <a href={`${import.meta.env.BASE_URL}experience/`} class="btn-neon mt-7 inline-block">See the full experience timeline</a>
        </div>

        <div class="reveal reveal-delay-2 divide-y divide-black/10 border-y border-black/10">
          {experienceSignals.map((signal) => (
            <div class="flex items-center gap-4 py-5">
              <VerifiedBrandBadge brand={signal.brand} size="sm" />
              <div>
                <p class="text-sm font-heading font-semibold text-text-bright">{signal.label}</p>
                <p class="mt-1 text-xs text-muted">{signal.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-black/5 py-16 md:py-20">
      <div class="section-container">
        <div class="reveal mx-auto max-w-3xl text-center">
          <p class="text-xs font-heading font-semibold uppercase tracking-[0.18em] text-neon-rose">Start here</p>
          <h2 class="mt-3 text-3xl font-heading font-bold tracking-[-0.03em] text-text-bright md:text-4xl">Working toward healthier, safer communities?</h2>
          <p class="mt-5 text-lg leading-relaxed text-muted">I welcome conversations about public health, research, community safety, advocacy, and partnerships.</p>
          <div class="mt-8 flex justify-center gap-3">
            <a href={`${import.meta.env.BASE_URL}contact/`} class="btn-neon-fill">Start a conversation</a>
            <a href={`${import.meta.env.BASE_URL}projects/`} class="btn-neon">View all projects</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
