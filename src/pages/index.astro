---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const outcomes = [
  { value: '40,000+', label: 'people reached', context: 'Safety resources, workshops, and community initiatives' },
  { value: '63', label: 'Safe Hubs across 20 cities', context: 'A growing network of safer community spaces' },
  { value: '80+', label: 'team members managed', context: 'Building the team behind BOLT Safety Society' },
];

const initiatives = [
  { number: '01', label: 'Community safety', title: 'Building safer spaces with BOLT.', description: 'Co-founded and scaled a federally registered nonprofit addressing sexual violence through digital resources, workshops, a Safe Hubs network, documentary film production, and a national safety hotline.', metric: '40,000+', metricLabel: 'people reached' },
  { number: '02', label: 'Partnerships & advocacy', title: 'Turning partnerships into public impact.', description: 'Built partnerships with L’Oréal Paris, Ted Baker, Guest In Residence, Kulfi Beauty, and NightCap. BOLT’s humanitarian impact extends across Kenya, India, Colombia, the USA, and Uganda.', metric: '2.2M+', metricLabel: 'partnership impressions' },
  { number: '03', label: 'Nonprofit leadership', title: 'Growing the capacity to make change.', description: 'Led people, operations, and fundraising to expand a safety-focused nonprofit, securing grants and developing a network of 63 Safe Hubs across 20 cities.', metric: '$38,000', metricLabel: 'in grant funding raised' },
];

const experience = [
  { date: '2017–Present', organization: 'BOLT Safety Society', role: 'Co-Founder, Executive Director & Chairperson', location: 'Vancouver, BC', detail: 'Lead strategy, partnerships, and fundraising to advance community safety and equity. Managed 80+ team members and built initiatives reaching more than 40,000 people.' },
  { date: '2025', organization: 'Concordia', role: 'Coordinator, Data and CRM Systems · Executive Office', location: 'New York, NY · Remote', detail: 'Supported international events, including a major public-private convening alongside the UN General Assembly. Managed CRM data and invitation workflows, supervised interns, coordinated stakeholders, and performed UI/UX testing.' },
  { date: '2014–2025', organization: 'BC Heritage Fairs Society', role: 'Board of Directors & BC Provincial Heritage Fair Coordinator', location: 'Metro Vancouver, BC', detail: 'Served on a board managing $85,000+ in charitable assets and spearheaded the largest Provincial Heritage Fair in Canada, with recognition and support from national, provincial, and local leaders.' },
  { date: '2017–2024', organization: 'St. John Ambulance', role: 'First Aid Training Officer & Advanced Medical First Responder', location: 'Metro Vancouver, BC', detail: 'Served as a D02 Rank (2 Star) Officer, provided emergency first aid at community events, and mentored youth cadets in leadership and clinical skills.' },
];

const research = [
  { date: '2026–2027', organization: 'Berner Lab · Icahn School of Medicine at Mount Sinai', role: 'Master’s Student', detail: 'Training in clinical and research methodologies in the Department of Psychiatry, including participant recruitment, psychodiagnostic assessment, fNIRS/fMRI data collection, student coordination, and database management.' },
  { date: '2022–2023', organization: 'BC Injury Research and Prevention Unit', role: 'Research Volunteer · SHRed Concussions Study', detail: 'Supported a youth-athlete concussion study funded by the NFL Scientific Advisory Board through participant follow-ups and hospital-site data collection, alongside work supporting the Canadian Injury Prevention Conference.' },
  { date: '2021', organization: 'Antarctic Institute of Canada', role: 'Research Intern & Co-author', detail: 'Co-authored four publications exploring human evolution, schizophrenia, and the mental health implications of COVID-19.' },
  { date: '2020–2022', organization: 'Ye Research Group · Stewart Blusson Quantum Matter Institute', role: 'Lab Assistant', detail: 'Prepared graphene and nanomaterials for investigations of novel optical properties. Co-presented at UBC’s Multidisciplinary Undergraduate Research Conference.' },
];

const publications = [
  { title: 'Neanderthals: Exploring our Genetic Past and Present', chapter: 'Chapter 9', url: 'https://www.lulu.com/shop/joylen-kingsley-and-vedanshi-vala-and-omar-abdul-hadi-and-romina-tabesh/neanderthals-exploring-our-genetic-past-and-present/paperback/product-68wnpm.html?q=Neanderthals%3A+Exploring+our+Genetic+Past+and+Present&page=1&pageSize=4' },
  { title: 'Over the Edge and Into the Deep End: Schizophrenia and the Bounds of the Human Mind', chapter: 'Chapter 6', url: 'https://www.lulu.com/shop/romnia-tabesh-and-lillian-yeung-and-sara-djeddi-and-vendashi-vala/over-the-edge-and-into-the-deep-end-schizophrenia-and-the-bounds-of-the-human-mind/paperback/product-5nkgd4.html?q=Over+the+Edge+and+Into+the+Deep+End%3A+Schizophrenia+and+the+Bounds+of+the+Human+Mind&page=1&pageSize=4' },
  { title: 'Surviving the Shadow Pandemic: The Mental Health Implications of COVID-19', chapter: 'Chapter 3', url: 'https://www.lulu.com/shop/shannon-lin-and-lilian-yeung-and-joylen-kingsley-and-romina-tabesh/surviving-the-shadow-pandemic-the-mental-health-implications-of-covid-19/paperback/product-q7vrp2.html?q=Surviving+the+Shadow+Pandemic%3A+The+Mental+Health+Implications+of+COVID-19&page=1&pageSize=4' },
  { title: 'Homo Floresiensis: Diving Deep into our Evolutionary Past', chapter: 'Chapter 11', url: 'https://www.lulu.com/shop/vedanshi-vala-and-ann-ping-and-michaela-dowling-and-shannon-lin/homo-floresiensis-diving-deep-into-our-evolutionary-past/paperback/product-k2k4qq.html?page=1&pageSize=4' },
];

const honours = [
  { date: '2023–2026', title: 'UN Commission on the Status of Women', detail: 'Panelist and four-time representative' },
  { date: '2026', title: 'UNFPA Global Symposium on Technology-Facilitated GBV', detail: 'Moderator · 4th Global Symposium' },
  { date: '2025', title: 'Office of the Vice President of Colombia', detail: 'Conference panelist' },
  { date: '2025', title: 'Government of Canada Volunteer Award', detail: 'National recognition for volunteer service' },
  { date: '2025', title: 'RBC LEADHER Award', detail: 'Featured by ELLE' },
  { date: '2024', title: 'One Young World · Novartis Scholar', detail: 'Top 0.66% of 74,000+ global applicants' },
  { date: '2022', title: 'L’Oréal Paris Woman of Worth', detail: 'One of 10 national honourees' },
];

const skills = [
  { title: 'Leadership & advocacy', detail: 'People, project, budget, and operations management; strategic planning; institutional policy; stakeholder engagement; partnerships; grant writing; fundraising; public speaking; media and governmental relations.' },
  { title: 'Research & analysis', detail: 'Clinical data collection and management, statistical analysis and interpretation, survey design, and scientific literature review and synthesis.' },
  { title: 'Tools & technology', detail: 'REDCap, Salesforce, Swoogo, QGIS, Microsoft Office, Google Workspace, and Wondershare Filmora. Working proficiency in HTML, Python, R, and SAS.' },
];
---

<Layout title="Vedanshi Vala — Public Health Leader & Founder" description="Vedanshi Vala is a public health leader, co-founder of BOLT Safety Society, and MPH candidate advancing community safety and equity." ogType="profile">
  <Navigation />
  <main id="main-content">
    <section id="about" class="relative overflow-hidden border-b border-black/5 py-14 md:py-20">
      <div class="absolute inset-0 grid-bg opacity-35" aria-hidden="true"></div>
      <div class="absolute -left-24 top-10 h-80 w-80 rounded-full bg-neon-gold/10 blur-3xl" aria-hidden="true"></div>
      <div class="section-container relative z-10 grid items-center gap-12 lg:grid-cols-[minmax(0,1.25fr)_minmax(320px,0.75fr)]">
        <div>
          <p class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-neon-rose">Founder · Public health leader · MPH candidate</p>
          <h1 class="mt-5 text-5xl font-heading font-bold leading-none tracking-[-0.04em] text-text-bright sm:text-6xl lg:text-7xl">Vedanshi Vala<span class="text-neon-rose">.</span></h1>
          <p class="mt-6 max-w-2xl text-3xl font-heading font-semibold leading-tight tracking-[-0.025em] text-text md:text-4xl">Building safer, more equitable communities.</p>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">I’m a founder with 9+ years of executive leadership experience scaling public health initiatives across countries. At BOLT Safety Society, I bring people, partnerships, and evidence together to advance safety and equity.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#impact" class="btn-neon-fill">Explore my work</a>
            <a href="#contact" class="btn-neon">Get in touch</a>
          </div>
          <p class="mt-8 border-t border-black/10 pt-5 text-sm leading-relaxed text-muted">Currently pursuing a Master of Public Health at the Icahn School of Medicine at Mount Sinai.</p>
        </div>
        <aside class="rounded-2xl border border-black/10 bg-surface p-6 shadow-neon-lg md:p-8" aria-label="BOLT Safety Society impact">
          <p class="text-xs font-heading font-semibold uppercase tracking-[0.18em] text-neon-rose">BOLT Safety Society</p>
          <h2 class="mt-3 text-2xl font-heading font-semibold tracking-tight text-text-bright">Community impact, at a glance.</h2>
          <dl class="mt-5 divide-y divide-black/10">
            {outcomes.map((item) => (
              <div class="py-5">
                <dt class="text-sm font-semibold text-text">{item.label}</dt>
                <dd class="mt-1 text-4xl font-heading font-bold tracking-tight text-neon-rose">{item.value}</dd>
                <dd class="mt-2 text-sm leading-relaxed text-muted">{item.context}</dd>
              </div>
            ))}
          </dl>
          <a class="link-neon inline-block mt-2 text-sm font-medium" href="https://boltsafety.org" target="_blank" rel="noopener noreferrer">Visit BOLT Safety Society <span aria-hidden="true">↗</span></a>
        </aside>
      </div>
    </section>

    <section id="impact" class="border-b border-black/5 bg-surface-light/40 py-14 md:py-16">
      <div class="section-container">
        <p class="section-eyebrow">Selected impact</p>
        <h2 class="section-heading">From advocacy to action.</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {initiatives.map((item) => (
            <article class="card-neon flex flex-col">
              <p class="text-xs font-mono uppercase tracking-wider text-neon-rose">{item.number} / {item.label}</p>
              <h3 class="mt-5 text-2xl font-heading font-semibold leading-tight text-text-bright">{item.title}</h3>
              <p class="mt-4 flex-1 text-sm leading-7 text-muted">{item.description}</p>
              <div class="mt-7 border-t border-black/10 pt-5">
                <p class="text-3xl font-heading font-bold text-neon-rose">{item.metric}</p>
                <p class="mt-1 text-sm text-muted">{item.metricLabel}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="experience" class="py-14 md:py-16">
      <div class="section-container">
        <p class="section-eyebrow">Experience</p>
        <h2 class="section-heading">Leading people. Strengthening communities.</h2>
        <div class="mt-8 divide-y divide-black/10 border-y border-black/10">
          {experience.map((item) => (
            <article class="grid gap-4 py-7 md:grid-cols-[160px_minmax(0,1fr)] md:gap-8">
              <p class="font-mono text-sm text-neon-rose">{item.date}</p>
              <div>
                <h3 class="text-xl font-heading font-semibold text-text-bright">{item.organization}</h3>
                <p class="mt-1 text-base font-medium text-text">{item.role}</p>
                <p class="mt-2 text-xs text-muted">{item.location}</p>
                <p class="mt-3 max-w-3xl text-sm leading-7 text-muted">{item.detail}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="research" class="border-y border-black/5 bg-surface-light/40 py-14 md:py-16">
      <div class="section-container">
        <p class="section-eyebrow">Research & publications</p>
        <h2 class="section-heading">Curiosity grounded in evidence.</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-2">
          {research.map((item) => (
            <article class="card-neon">
              <p class="font-mono text-xs text-neon-rose">{item.date} · {item.role}</p>
              <h3 class="mt-3 text-lg font-heading font-semibold text-text-bright">{item.organization}</h3>
              <p class="mt-3 text-sm leading-7 text-muted">{item.detail}</p>
            </article>
          ))}
        </div>
        <details class="mt-6 rounded-xl border border-black/10 bg-surface p-5">
          <summary class="cursor-pointer font-heading font-semibold text-neon-rose">Explore four co-authored publications</summary>
          <ul class="mt-4 grid gap-4 md:grid-cols-2">
            {publications.map((item) => (
              <li class="border-t border-black/10 pt-4">
                <a class="link-neon text-sm leading-relaxed" href={item.url} target="_blank" rel="noopener noreferrer">{item.title} <span aria-hidden="true">↗</span></a>
                <p class="mt-1 text-xs text-muted">2021 · {item.chapter}</p>
              </li>
            ))}
          </ul>
        </details>
      </div>
    </section>

    <section id="education" class="py-14 md:py-16">
      <div class="section-container">
        <p class="section-eyebrow">Education</p>
        <h2 class="section-heading">A foundation in science and global health.</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-2">
          <article class="card-neon">
            <p class="badge-neon">In progress · Expected June 2027</p>
            <h3 class="mt-5 text-2xl font-heading font-semibold text-text-bright">Master of Public Health</h3>
            <p class="mt-2 font-medium text-text">Icahn School of Medicine at Mount Sinai</p>
            <p class="mt-3 text-sm leading-7 text-muted">Global Health concentration · Epidemiology minor<br />STEM-designated program</p>
            <p class="mt-4 font-mono text-xs text-muted">January 2026–June 2027 · New York, NY</p>
          </article>
          <article class="card-neon">
            <p class="badge-neon">Graduated 2024</p>
            <h3 class="mt-5 text-2xl font-heading font-semibold text-text-bright">Bachelor of Science</h3>
            <p class="mt-2 font-medium text-text">University of British Columbia</p>
            <p class="mt-3 text-sm leading-7 text-muted">Major in Integrated Sciences</p>
            <p class="mt-4 font-mono text-xs text-muted">Vancouver, BC</p>
          </article>
        </div>
      </div>
    </section>

    <section class="border-y border-black/5 bg-surface-light/40 py-14 md:py-16" aria-labelledby="recognition-heading">
      <div class="section-container grid gap-8 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:gap-14">
        <div>
          <p class="section-eyebrow">Honours & global engagement</p>
          <h2 id="recognition-heading" class="section-heading">A voice for safety and equity.</h2>
          <p class="mt-5 text-base leading-relaxed text-muted">Contributing to international conversations on gender-based violence, community leadership, and public health.</p>
        </div>
        <ul class="divide-y divide-black/10 border-y border-black/10">
          {honours.map((item) => (
            <li class="grid grid-cols-[84px_minmax(0,1fr)] gap-4 py-4">
              <p class="font-mono text-xs text-neon-rose">{item.date}</p>
              <div><h3 class="font-heading font-semibold text-text-bright">{item.title}</h3><p class="mt-1 text-sm leading-relaxed text-muted">{item.detail}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="py-14 md:py-16" aria-labelledby="skills-heading">
      <div class="section-container">
        <p class="section-eyebrow">Skills</p>
        <h2 id="skills-heading" class="section-heading">The tools behind the work.</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {skills.map((item) => (
            <div class="border-t-2 border-neon-rose/35 pt-5">
              <h3 class="text-lg font-heading font-semibold text-text-bright">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-muted">{item.detail}</p>
            </div>
          ))}
        </div>
        <p class="mt-8 text-sm text-muted"><strong class="text-text">Languages:</strong> English, French, Hindi, and Gujarati.</p>
      </div>
    </section>

    <section id="contact" class="border-t border-black/5 bg-surface-light/40 py-14 md:py-20">
      <div class="section-container max-w-3xl text-center">
        <p class="section-eyebrow">Get in touch</p>
        <h2 class="section-heading">Let’s build healthier, safer communities.</h2>
        <p class="mt-5 text-base leading-relaxed text-muted">Connect with me about public health, research, community safety, and partnerships.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="mailto:vedanshi.vala@icahn.mssm.edu" class="btn-neon-fill">Email Vedanshi</a>
          <a href="https://www.linkedin.com/in/vedanshivala/" class="btn-neon" target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
        <a href="mailto:vedanshi.vala@icahn.mssm.edu" class="mt-5 inline-block break-all text-sm text-muted underline underline-offset-4 hover:text-neon-rose">vedanshi.vala@icahn.mssm.edu</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .section-eyebrow { @apply text-xs font-heading font-semibold uppercase tracking-[0.18em] text-neon-rose; }
  .section-heading { @apply mt-3 text-3xl font-heading font-bold tracking-[-0.03em] text-text-bright md:text-4xl; }
  section[id] { scroll-margin-top: 5rem; }
</style>
